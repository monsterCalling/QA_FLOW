{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "defect-candidates",
  "type": "object",
  "required": [
    "change_id",
    "candidates"
  ],
  "properties": {
    "change_id": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_test",
          "summary",
          "severity",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_test": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "classification": {
            "const": "PRODUCT_DEFECT"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}