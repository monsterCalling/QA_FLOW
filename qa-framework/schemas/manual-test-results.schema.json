{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manual-test-results",
  "type": "object",
  "required": [
    "change_id",
    "results"
  ],
  "properties": {
    "change_id": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "status"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "defect_reference": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}